generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model MealSignup {
  id           String   @id @default(cuid())
  date         DateTime
  location     String   @default("Brick Building")
  name         String
  email        String
  phone        String
  bringing     String
  notes        String?
  cancelToken  String   @unique @default(cuid())
  reminderSent Boolean  @default(false)
  cancelled    Boolean  @default(false)
  cancelledAt  DateTime?
  createdAt    DateTime @default(now())
}

model SiteSettings {
  id          String   @id @default("main")
  kidCountMin Int      @default(8)
  kidCountMax Int      @default(12)
  updatedAt   DateTime @updatedAt
}

model ImpactStory {
  id        String   @id @default(cuid())
  title     String
  content   String
  imageUrl  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}

model BlockedDate {
  id   String   @id @default(cuid())
  date DateTime @unique
}

model VolunteerInterest {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String
  townCity       String
  signupType     String
  groupName      String?
  interests      String[]
  otherInterest  String?
  availability   String?
  hearAbout      String?
  additionalInfo String?
  submittedAt    DateTime @default(now())
}

model VolunteerApplication {
  id String @id @default(cuid())

  // Section 1 — About You
  fullName      String
  streetAddress String
  townCity      String
  state         String @default("CT")
  zip           String
  email         String
  phone         String

  emergencyName         String
  emergencyRelationship String
  emergencyPhone        String

  // Section 2 — Tier selection ("Tier 3" or "Tier 4").
  // `roles` is retained for backward compatibility but no longer populated.
  tier         String   @default("")
  roles        String[]
  tier4Applied Boolean  @default(false)

  // Section 3 — Experience
  priorExperience  String?
  specialTraining  String?
  communityService String?

  // Section 4 — References
  reference1Name  String
  reference1Phone String
  reference1Email String
  reference2Name  String
  reference2Phone String
  reference2Email String

  // Sections 5–9 — Acknowledgments
  agreeConduct            Boolean @default(false)
  agreeConfidentiality    Boolean @default(false)
  agreeResidentGuidelines Boolean @default(false)
  agreeMandatedReporter   Boolean @default(false)
  attestHealth            Boolean @default(false)

  // Section 10 — Signature
  signature String
  signedAt  DateTime @default(now())

  submittedAt DateTime @default(now())
}
